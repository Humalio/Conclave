# Only server/ and bridge/ are copied into the image; keep secrets and runtime data out of the build context.
.git
.env
.env.*
data
vault
local-vault
rehearsal-handoffs.json
# deploy/ stays out of the build context except the client bundle the Dockerfile copies.
deploy/*
!deploy/client
demo
docs
# eval/ ships the Early Echo story for demo mode (vault, story, runner); its reports stay out.
eval/out
**/node_modules
**/dist
