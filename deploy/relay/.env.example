# Copy to .env next to this file and fill it in. .env is never committed.

# The address PCs use to reach this relay: its IP (or a LAN name), as typed into the relay's registration
# in the hub console.
RELAY_HOST=192.168.1.20

# The hub's public name. The relay checks the hub's certificate against it and sends it as Host.
HUB_NAME=conclave.example.com
# Where to connect, if not HUB_NAME:443 (for example another port).
# HUB_UPSTREAM=conclave.example.com:443

# The relay's secret, made by the hub when the relay is registered (console, Relays). Leave it empty for the
# first start, which makes the relay's CA so you can register it; then paste it here and start again. Paste it here only:
# never in a prompt, a message or a file that is shared. Rotate it in the console if it may have leaked.
RELAY_SECRET=

# Ports the relay listens on. Plain HTTP serves only the onboarding downloads and redirects the rest.
HTTP_PORT=80
HTTPS_PORT=443
