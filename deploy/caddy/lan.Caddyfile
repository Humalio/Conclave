# HTTPS on a private network: an IP address or a LAN name without a public certificate.
# Caddy runs its own certificate authority; trust its root once per client (see docs/getting-started.md).
# The HTTPS site serves everything, MCP and bridge included, and is the recommended endpoint.
# The console and admin API are HTTPS only. Plain HTTP also carries machine traffic (MCP, bridge, health)
# so clients that do not trust the internal CA keep working, but app keys, session tokens, pairing codes
# and file contents then cross the network in clear text. Kept for compatibility; setup.sh warns about it.
{
	auto_https disable_redirects
	local_certs
	# Clients connecting by IP send no SNI; present this host's certificate anyway.
	default_sni {$HUB_HOST}
}

https://{$HUB_HOST}:{$HTTPS_PORT} {
	tls internal
	encode zstd gzip
	reverse_proxy agent-hub:8080
}

http://:{$HTTP_PORT} {
	@machine path /mcp /mcp/* /bridge/* /health
	handle @machine {
		reverse_proxy agent-hub:8080
	}
	# The hub has no OAuth. When a header login fails, an MCP client gets a 401 and falls back to
	# the spec's default OAuth endpoints; a 308 to HTTPS there makes it report a refused OAuth
	# redirect and hides the real cause. Answer them with 404 so the 401 stays visible.
	@oauth path /authorize /authorize/* /register /token /revoke
	handle @oauth {
		respond 404
	}
	# Likewise answer discovery here instead of redirecting it to the internal-CA
	# HTTPS port, where an MCP client fails with a certificate error that hides the real cause
	# (no app key sent).
	handle /.well-known/* {
		respond 404
	}
	handle {
		redir https://{$HUB_HOST}:{$HTTPS_PORT}{uri} 308
	}
}
