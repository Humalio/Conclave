# Conclave settings for docker compose. `deploy/setup.sh` writes a filled-in .env for you.
# Server settings are read from this file by the container; see server/src/config.ts for every option.

# Host directory mounted as the vault (absolute path). An Obsidian vault works as is.
VAULT_HOST_DIR=/srv/agent-hub/vault
VAULT_ALIAS=vault

# HMAC secret for key verifiers. Keep it stable and backed up: changing it invalidates every key.
# Generate with: openssl rand -hex 32
KEY_PEPPER=

# First admin, created only when the database has no admin yet. Remove the password after the
# first start (setup.sh does): the hub does not need it again.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Address clients use for MCP and bridge setup snippets (no trailing slash).
#   local:  http://localhost:8080
#   lan:    https://<host>:<HTTPS_PORT> once clients trust the internal certificate (recommended), or
#           http://<host>:<HTTP_PORT>, which sends keys and file contents unencrypted across the network
#   domain: https://<domain>
PUBLIC_URL=http://localhost:8080

# Host user that owns ./data and the vault (`id -u` / `id -g`).
HUB_UID=1000
HUB_GID=1000

# Without HTTPS the hub publishes itself on HUB_BIND:HUB_PORT. Keep 127.0.0.1 unless you add HTTPS:
# the admin session cookie is HTTPS-only, so the console cannot sign in over plain HTTP on a LAN address.
HUB_BIND=127.0.0.1
HUB_PORT=8080

# HTTPS (optional). Uncomment to put Caddy in front; the hub then stops publishing its own port.
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.https.yml
# HTTPS_MODE=lan            # lan: internal certificate for an IP or LAN name | domain: Let's Encrypt
# HUB_HOST=192.168.1.20     # IP or name clients use (lan), or the public domain (domain)
# HTTP_PORT=8080            # lan: plain HTTP for MCP/bridge (unencrypted); domain: 80
# HTTPS_PORT=8443           # lan: console, MCP and bridge over HTTPS; domain: 443
# ACME_EMAIL=you@example.com  # domain mode only
